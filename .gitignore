# Keep UPM documentation visible even with a global *~ ignore rule.
!/Documentation~/
!/Documentation~/**
/.DS_Store
**/.DS_Store
__pycache__/
*.pyc
/Library/
/Temp/
/Logs/
/UserSettings/
/Assets/
/ProjectSettings/
/Packages/
*.csproj
*.sln
/.idea/
/.vs/

# UPM ignores maintainer tools, but Git must retain them.
!/Tools~/
!/Tools~/**

__pycache__/
*.py[cod]

# Optional UPM puzzle sample
!/Samples~/
!/Samples~/**
